{
  "expo": {
    "name": "Auto-Fit",
    "slug": "auto-fit",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "autofit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
