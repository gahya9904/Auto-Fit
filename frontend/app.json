{
  "expo": {
    "name": "Auto-Fit",
    "slug": "auto-fit",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "autofit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "건강 데이터를 촬영하려면 카메라 접근 권한이 필요합니다.",
          "microphonePermission": false,
          "photosPermission": false
        }
      ],
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
